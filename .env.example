# Copy this file to `.env` and fill in real values: cp .env.example .env
# Do not commit `.env` (already in .gitignore).
#
# Read via process.env in src/configs/env.config.ts. Only variables prefixed
# with EXPO_PUBLIC_ get embedded into the app bundle (see
# https://docs.expo.dev/guides/environment-variables/).

# [REQUIRED] Base URL of the backend API that src/lib/api-client.ts calls.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# [OPTIONAL] Set to "0" to disable the mock API adapter and hit the real backend above.
EXPO_PUBLIC_API_MOCK=1
